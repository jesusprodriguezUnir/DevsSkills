---
import Layout from "../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";

interface Skill {
  id: string;
  name: string;
  description: string;
  category: string;
  license: string;
  compatibility: string | null;
  fileCount: number;
  rawSize: number;
  zipSize: number;
  subdirs: string[];
  body: string;
  bodyEs?: string | null;
  downloadUrl: string;
  image: string | null;
}

// Read the generated manifest
const manifestPath = path.join(process.cwd(), "src/data/skills-manifest.json");
const skills: Skill[] = JSON.parse(fs.readFileSync(manifestPath, "utf-8"));

// Resolve download URLs with base path
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
skills.forEach((s) => {
  s.downloadUrl = `${base}${s.downloadUrl}`;
  if (s.image) {
    s.image = `${base}${s.image}`;
  }
});

// Compute stats and category info
const categories = [...new Set(skills.map((s) => s.category))];
const totalDownloads = Math.floor(skills.length * 200); // Mock downloads

const categoryData = [
  { id: "all", name: "Todos", count: skills.length },
  ...categories.map(cat => ({
    id: cat,
    name: cat,
    count: skills.filter(s => s.category === cat).length
  }))
];
---

<Layout title="DevSkills Hub — Catálogo de Skills para Agentes IA">
  <main class="terminal-main">
    <!-- ─── Status Bar ─── -->
    <div class="term-status-bar">
      <div class="status-left">
        <span class="status-online">● online</span>
        <span class="status-path">~/devs-skills</span>
        <span class="status-branch">main</span>
      </div>
      <div class="status-right">
        <span class="status-encoding">UTF-8</span>
        <span class="status-encoding">LF</span>
        <button id="term-theme-toggle" class="status-theme" aria-label="Cambiar tema">[dark]</button>
      </div>
    </div>

    <!-- ─── Hero Section ─── -->
    <header class="term-hero">
      <pre class="term-ascii-art">██████╗ ███████╗██╗   ██╗███████╗   ███████╗██╗  ██╗██╗██╗     ██╗     ███████╗
██╔══██╗██╔════╝██║   ██║██╔════╝   ██╔════╝██║ ██╔╝██║██║     ██║     ██╔════╝
██║  ██║█████╗  ██║   ██║███████╗   ███████╗█████╔╝ ██║██║     ██║     ███████╗
██║  ██║██╔══╝  ╚██╗ ██╔╝╚════██║   ╚════██║██╔═██╗ ██║██║     ██║     ╚════██║
██████╔╝███████╗ ╚████╔╝ ███████║██╗███████║██║  ██╗██║███████╗███████╗███████║
╚═════╝ ╚══════╝  ╚═══╝  ╚══════╝╚═╝╚══════╝╚═╝  ╚═╝╚═╝╚══════╝╚══════╝╚══════╝</pre>

      <div class="term-hero-content">
        <div class="term-desc">
          <div class="term-prompt">$ devs-skills --list</div>
          <p class="term-tagline">
            <span class="term-symbol">›</span> A registry of <strong>SKILL.md</strong> packages
            for Claude Code, .NET, Python &amp; ops. Plain text. Auditable. Versioned.
          </p>
        </div>

        <div class="term-stats">
          <div class="term-stat">
            <div class="term-stat-label">SKILLS</div>
            <div class="term-stat-value">{skills.length}</div>
          </div>
          <div class="term-stat">
            <div class="term-stat-label">CATEGORIES</div>
            <div class="term-stat-value">{categories.length}</div>
          </div>
          <div class="term-stat">
            <div class="term-stat-label">DL/30d</div>
            <div class="term-stat-value downloads">{totalDownloads}</div>
          </div>
          <div class="term-stat">
            <div class="term-stat-label">LIC</div>
            <div class="term-stat-value">MIT</div>
          </div>
        </div>
      </div>
    </header>

    <!-- ─── Search & Filters ─── -->
    <section class="term-search-section">
      <div class="term-prompt-line">
        <span class="term-symbol">$</span>
        <span class="term-grep-cmd">grep -i</span>
        <input
          type="text"
          id="skill-search"
          class="term-search-input"
          placeholder="_"
          aria-label="Buscar skills"
          autocomplete="off"
        />
        <span class="term-search-path">./skills/**/SKILL.md</span>
      </div>

      <div class="term-filters">
        {categoryData.map((cat) => (
          <button
            class="term-filter-btn active"
            data-filter={cat.id}
            data-category={cat.id}
          >
            {cat.name === "Todos" ? "*" : cat.name.toLowerCase()}
            <span class="term-filter-count">{cat.count}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- ─── Skills Grid (2-column) ─── -->
    <section class="term-grid-section">
      <div class="term-grid-border" id="skills-grid">
        {skills.map((skill, idx) => (
          <article
            class="term-skill-card"
            data-category={skill.category}
            data-skill-id={skill.id}
            data-skill-name={skill.name.toLowerCase()}
            data-skill-desc={skill.description.toLowerCase()}
          >
            <div class="term-card-header">
              <div class="term-card-title-row">
                <span class="term-card-number">{String(idx + 1).padStart(2, "0")}</span>
                <span class="term-card-name">{skill.name}</span>
              </div>
              <span class="term-card-category">[{skill.category}]</span>
            </div>

            <p class="term-card-description">{skill.description}</p>

            <div class="term-card-footer">
              <span class="term-card-tags">
                {skill.subdirs.slice(0, 2).map(tag => `#${tag}`).join(" ")}
              </span>
              <span class="term-card-meta">
                {skill.fileCount}f · {(skill.zipSize / 1024).toFixed(1)}KB · <span class="term-downloads">↓ {Math.floor(Math.random() * 500)}</span>
              </span>
            </div>

            <div class="term-card-actions">
              <button class="term-btn term-btn-ghost" data-modal-trigger={`modal-${skill.id}`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                Ver
              </button>
              <a href={skill.downloadUrl} class="term-btn term-btn-primary" download>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                ZIP
              </a>
            </div>

            <!-- Modal con soporte bilingüe -->
            <dialog id={`modal-${skill.id}`} class="term-modal">
              <div class="modal-wrapper">
                <div class="modal-header">
                  <div class="modal-title-group">
                    {skill.image && <img src={skill.image} class="modal-mini-image" alt="" />}
                    <div>
                      <span class="modal-category">[{skill.category}]</span>
                      <h2>{skill.name}</h2>
                    </div>
                  </div>
                  <div class="modal-header-actions">
                    {skill.bodyEs && (
                      <button class="lang-toggle" data-target={`modal-${skill.id}`} data-lang="en" aria-label="Cambiar idioma" title="Ver en Español">
                        <span class="flag-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 750 500" width="20" height="14" style="border-radius: 2px;">
                            <rect width="750" height="500" fill="#c60b1e"/>
                            <rect y="125" width="750" height="250" fill="#ffc400"/>
                          </svg>
                        </span>
                      </button>
                    )}
                    <button class="modal-close" data-modal-close={`modal-${skill.id}`} aria-label="Cerrar">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                  </div>
                </div>
                <div class="modal-body">
                  <div id={`content-en-${skill.id}`}>
                    <pre><code>{skill.body}</code></pre>
                  </div>
                  {skill.bodyEs && (
                    <div id={`content-es-${skill.id}`} style="display: none;">
                      <pre><code>{skill.bodyEs}</code></pre>
                    </div>
                  )}
                </div>
                <div class="modal-footer">
                  <a href={skill.downloadUrl} class="term-btn term-btn-primary term-btn-lg" download>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Descargar ({(skill.zipSize / 1024).toFixed(1)}KB)
                  </a>
                </div>
              </div>
            </dialog>
          </article>
        ))}
      </div>

      <div class="term-footer-info">
        <span id="visible-count">{skills.length} results</span> · press <span class="term-accent">/</span> to search · <span class="term-accent">↵</span> to open
      </div>
    </section>

    <!-- ─── External Ecosystem ─── -->
    <section class="term-ecosystem-section">
      <div class="term-prompt-line">
        <span class="term-symbol">$</span>
        <span class="term-grep-cmd">ls -la</span>
        <span class="term-search-path">--external-resources</span>
      </div>
      
      <div class="term-ecosystem-grid">
        <a href="https://www.skills.sh/" target="_blank" rel="noopener noreferrer" class="ecosystem-card">
          <div class="ecosystem-header">
            <span class="ecosystem-title">skills.sh</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </div>
          <p class="ecosystem-desc">Registry of AI Agent Skills & Toolsets</p>
        </a>

        <a href="https://awesomeclaude.ai/" target="_blank" rel="noopener noreferrer" class="ecosystem-card">
          <div class="ecosystem-header">
            <span class="ecosystem-title">awesomeclaude.ai</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </div>
          <p class="ecosystem-desc">Curated list of resources for Claude & Anthropic</p>
        </a>

        <a href="https://aitmpl.com/" target="_blank" rel="noopener noreferrer" class="ecosystem-card">
          <div class="ecosystem-header">
            <span class="ecosystem-title">aitmpl.com</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </div>
          <p class="ecosystem-desc">Professional AI Prompt Templates & Components</p>
        </a>

      </div>
    </section>

  </main>
</Layout>

<script>
  function setupTerminal() {
    const searchInput = document.getElementById("skill-search") as HTMLInputElement;
    const grid = document.getElementById("skills-grid")!;
    const cards = grid.querySelectorAll<HTMLElement>(".term-skill-card");
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".term-filter-btn");
    const visibleCount = document.getElementById("visible-count")!;
    const themeBtn = document.getElementById("term-theme-toggle");
    const total = cards.length;

    let activeCategory = "all";

    function applyFilters() {
      const query = searchInput.value.toLowerCase().trim();
      let visible = 0;

      cards.forEach((card) => {
        const name = card.getAttribute("data-skill-name") || "";
        const desc = card.getAttribute("data-skill-desc") || "";
        const category = card.getAttribute("data-category") || "";

        const matchesSearch = !query || name.includes(query) || desc.includes(query);
        const matchesCategory = activeCategory === "all" || category === activeCategory;
        const show = matchesSearch && matchesCategory;

        card.style.display = show ? "" : "none";
        if (show) visible++;
      });

      visibleCount.textContent = `${visible} results`;
    }

    // Modal management
    document.querySelectorAll<HTMLButtonElement>('[data-modal-trigger]').forEach(btn => {
      btn.addEventListener('click', () => {
        const modalId = btn.getAttribute('data-modal-trigger')!;
        const modal = document.getElementById(modalId) as HTMLDialogElement;
        modal?.showModal();
        document.body.style.overflow = 'hidden';
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-modal-close]').forEach(btn => {
      btn.addEventListener('click', () => {
        const modalId = btn.getAttribute('data-modal-close')!;
        const modal = document.getElementById(modalId) as HTMLDialogElement;
        modal?.close();
        document.body.style.overflow = '';
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.term-modal').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.close();
          document.body.style.overflow = '';
        }
      });
    });

    // Language toggle
    document.querySelectorAll<HTMLButtonElement>('.lang-toggle').forEach(btn => {
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', () => {
        const modalId = newBtn.getAttribute('data-target')!;
        const id = modalId.replace('modal-', '');
        const currentLang = newBtn.getAttribute('data-lang');
        
        const contentEn = document.getElementById(`content-en-${id}`);
        const contentEs = document.getElementById(`content-es-${id}`);
        const flagSpan = newBtn.querySelector('.flag-icon')!;

        if (currentLang === 'en') {
          if (contentEn) contentEn.style.display = 'none';
          if (contentEs) contentEs.style.display = 'block';
          newBtn.setAttribute('data-lang', 'es');
          newBtn.title = "View in English";
          flagSpan.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30" width="20" height="14" style="border-radius: 2px;"><clipPath id="s"><path d="M0,0 v30 h60 v-30 z"/></clipPath><clipPath id="t"><path d="M30,15 h30 v15 z v-15 h-30 z h-30 v-15 z v15 h30 z"/></clipPath><g clip-path="url(#s)"><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#t)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></g></svg>';
        } else {
          if (contentEn) contentEn.style.display = 'block';
          if (contentEs) contentEs.style.display = 'none';
          newBtn.setAttribute('data-lang', 'en');
          newBtn.title = "Ver en Español";
          flagSpan.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 750 500" width="20" height="14" style="border-radius: 2px;"><rect width="750" height="500" fill="#c60b1e"/><rect y="125" width="750" height="250" fill="#ffc400"/></svg>';
        }
      });
    });

    // Search and filtering
    searchInput.addEventListener("input", applyFilters);
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        searchInput.value = "";
        searchInput.blur();
        applyFilters();
      }
    });

    // Filter button clicks
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeCategory = btn.getAttribute("data-filter") || "all";
        applyFilters();
      });
    });

    // "/" key to focus search
    document.addEventListener("keydown", (e) => {
      if (e.key === "/" && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
      }
    });

    // ESC key for modals
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.body.style.overflow = '';
      }
    });

    // Theme toggle
    if (themeBtn) {
      themeBtn.addEventListener("click", () => {
        const element = document.documentElement;
        const currentTheme = element.getAttribute("data-theme") || "dark";
        const targetTheme = currentTheme === "light" ? "dark" : "light";

        element.setAttribute("data-theme", targetTheme);
        localStorage.setItem("theme", targetTheme);
        themeBtn.textContent = `[${targetTheme}]`;
      });

      // Set initial text
      const currentTheme = document.documentElement.getAttribute("data-theme") || "dark";
      themeBtn.textContent = `[${currentTheme}]`;
    }
  }

  setupTerminal();
  document.addEventListener("astro:after-swap", setupTerminal);
</script>

<style>
  .terminal-main {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    font-family: "JetBrains Mono", monospace;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--term-bg);
    color: var(--term-text);
    overflow-x: hidden;
  }

  /* Scanlines effect */
  .terminal-main::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 100;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 2px,
      var(--term-scanline) 2px 3px
    );
  }

  /* Status Bar */
  .term-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 16px;
    border-bottom: 1px solid var(--term-border);
    background: var(--term-surf);
    font-size: 11px;
    color: var(--term-text-secondary);
    gap: 14px;
    flex-shrink: 0;
  }

  .status-left,
  .status-right {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .status-online {
    color: var(--term-accent);
  }

  .status-theme {
    background: none;
    border: none;
    color: var(--term-text-secondary);
    cursor: pointer;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    padding: 0;
    transition: color 150ms;
  }

  .status-theme:hover {
    color: var(--term-accent);
  }

  /* Hero Section */
  .term-hero {
    padding: 28px 32px 20px;
    border-bottom: 1px solid var(--term-border);
  }

  .term-ascii-art {
    margin: 0;
    font-family: "JetBrains Mono", monospace;
    color: var(--term-accent);
    font-size: 11px;
    line-height: 1.1;
    letter-spacing: 0;
    text-shadow: 0 0 8px var(--term-accent-glow);
  }

  .term-hero-content {
    margin-top: 16px;
    display: flex;
    gap: 40px;
    align-items: flex-end;
  }

  .term-desc {
    flex: 1;
  }

  .term-prompt {
    color: var(--term-text-tertiary);
    font-size: 12px;
    margin-bottom: 6px;
  }

  .term-tagline {
    margin: 0;
    font-size: 14px;
    color: var(--term-text);
    max-width: 580px;
    line-height: 1.55;
    font-family: system-ui, sans-serif;
  }

  .term-symbol {
    color: var(--term-accent);
    font-family: "JetBrains Mono", monospace;
  }

  .term-stats {
    display: flex;
    gap: 24px;
    font-size: 11px;
    color: var(--term-text-secondary);
  }

  .term-stat {
    display: flex;
    flex-direction: column;
  }

  .term-stat-label {
    color: var(--term-text-tertiary);
    font-size: 10px;
    margin-bottom: 2px;
  }

  .term-stat-value {
    font-size: 22px;
    color: var(--term-accent);
    font-weight: 600;
    font-family: "JetBrains Mono", monospace;
  }

  .term-stat-value.downloads {
    color: var(--term-warn);
  }

  /* Search & Filters */
  .term-search-section {
    padding: 12px 16px;
    border-bottom: 1px solid var(--term-border);
    background: var(--term-surf);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .term-prompt-line {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    max-width: 380px;
  }

  .term-symbol {
    color: var(--term-accent);
  }

  .term-grep-cmd {
    color: var(--term-text-secondary);
  }

  #skill-search {
    background: none;
    border: none;
    color: var(--term-text);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    flex: 1;
    border-bottom: 1px solid var(--term-text-tertiary);
    padding-bottom: 1px;
    outline: none;
  }

  #skill-search::placeholder {
    color: var(--term-text);
  }

  .term-search-path {
    color: var(--term-text-tertiary);
    font-size: 12px;
  }

  .term-filters {
    display: flex;
    gap: 4px;
  }

  .term-filter-btn {
    padding: 4px 10px;
    border-radius: 0;
    background: transparent;
    color: var(--term-text-secondary);
    border: 1px solid var(--term-border);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    cursor: pointer;
    transition: all 150ms;
  }

  .term-filter-btn:hover {
    border-color: var(--term-accent);
    color: var(--term-accent);
  }

  .term-filter-btn.active {
    background: var(--term-text);
    color: var(--term-bg);
    border-color: var(--term-text);
  }

  .term-filter-count {
    opacity: 0.5;
    margin-left: 4px;
  }

  /* Grid Section */
  .term-grid-section {
    flex: 1;
    overflow: auto;
