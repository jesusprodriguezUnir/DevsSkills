---
import Layout from "../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";

interface Skill {
  id: string;
  name: string;
  description: string;
  category: string;
  license: string;
  compatibility: string | null;
  fileCount: number;
  rawSize: number;
  zipSize: number;
  subdirs: string[];
  body: string;
  bodyEs?: string | null;
  downloadUrl: string;
  image: string | null;
}

// Read the generated manifest
const manifestPath = path.join(process.cwd(), "src/data/skills-manifest.json");
const skills: Skill[] = JSON.parse(fs.readFileSync(manifestPath, "utf-8"));

// Resolve download URLs with base path
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
skills.forEach((s) => {
  s.downloadUrl = `${base}${s.downloadUrl}`;
  if (s.image) {
    s.image = `${base}${s.image}`;
  }
});

// Compute stats and category info
const categories = [...new Set(skills.map((s) => s.category))];
const totalDownloads = Math.floor(skills.length * 200); // Mock downloads

const categoryData = [
  { id: "all", name: "Todos", count: skills.length },
  ...categories.map(cat => ({
    id: cat,
    name: cat,
    count: skills.filter(s => s.category === cat).length
  }))
];
---

<Layout title="DevSkills Hub — Catálogo de Skills para Agentes IA">
  <main class="terminal-main">
    <!-- ─── Status Bar ─── -->
    <div class="term-status-bar">
      <div class="status-left">
        <span class="status-online">● online</span>
        <span class="status-path">~/devs-skills</span>
        <span class="status-branch">main</span>
      </div>
      <div class="status-right">
        <span class="status-encoding">UTF-8</span>
        <span class="status-encoding">LF</span>
        <button id="term-theme-toggle" class="status-theme" aria-label="Cambiar tema">[dark]</button>
      </div>
    </div>

    <!-- ─── Hero Section ─── -->
    <header class="term-hero">
      <pre class="term-ascii-art">██████╗ ███████╗██╗   ██╗███████╗   ███████╗██╗  ██╗██╗██╗     ██╗     ███████╗
██╔══██╗██╔════╝██║   ██║██╔════╝   ██╔════╝██║ ██╔╝██║██║     ██║     ██╔════╝
██║  ██║█████╗  ██║   ██║███████╗   ███████╗█████╔╝ ██║██║     ██║     ███████╗
██║  ██║██╔══╝  ╚██╗ ██╔╝╚════██║   ╚════██║██╔═██╗ ██║██║     ██║     ╚════██║
██████╔╝███████╗ ╚████╔╝ ███████║██╗███████║██║  ██╗██║███████╗███████╗███████║
╚═════╝ ╚══════╝  ╚═══╝  ╚══════╝╚═╝╚══════╝╚═╝  ╚═╝╚═╝╚══════╝╚══════╝╚══════╝</pre>

      <div class="term-hero-content">
        <div class="term-desc">
          <div class="term-prompt">$ devs-skills --list</div>
          <p class="term-tagline">
            <span class="term-symbol">›</span> A registry of <strong>SKILL.md</strong> packages
            for Claude Code, .NET, Python &amp; ops. Plain text. Auditable. Versioned.
          </p>
        </div>

        <div class="term-stats">
          <div class="term-stat">
            <div class="term-stat-label">SKILLS</div>
            <div class="term-stat-value">{skills.length}</div>
          </div>
          <div class="term-stat">
            <div class="term-stat-label">CATEGORIES</div>
            <div class="term-stat-value">{categories.length}</div>
          </div>
          <div class="term-stat">
            <div class="term-stat-label">DL/30d</div>
            <div class="term-stat-value downloads">{totalDownloads}</div>
          </div>
          <div class="term-stat">
            <div class="term-stat-label">LIC</div>
            <div class="term-stat-value">MIT</div>
          </div>
        </div>
      </div>
    </header>

    <!-- ─── Search & Filters ─── -->
    <section class="term-search-section">
      <div class="term-prompt-line">
        <span class="term-symbol">$</span>
        <span class="term-grep-cmd">grep -i</span>
        <input
          type="text"
          id="skill-search"
          class="term-search-input"
          placeholder="_"
          aria-label="Buscar skills"
          autocomplete="off"
        />
        <span class="term-search-path">./skills/**/SKILL.md</span>
      </div>

      <div class="term-filters">
        {categoryData.map((cat) => (
          <button
            class="term-filter-btn active"
            data-filter={cat.id}
            data-category={cat.id}
          >
            {cat.name === "Todos" ? "*" : cat.name.toLowerCase()}
            <span class="term-filter-count">{cat.count}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- ─── Skills Grid (2-column) ─── -->
    <section class="term-grid-section">
      <div class="term-grid-border" id="skills-grid">
        {skills.slice(0, 8).map((skill, idx) => (
          <article class="term-skill-card" data-category={skill.category} data-skill-id={skill.id}>
            <div class="term-card-header">
              <div class="term-card-title-row">
                <span class="term-card-number">{String(idx + 1).padStart(2, "0")}</span>
                <span class="term-card-name">{skill.name}</span>
              </div>
              <span class="term-card-category">[{skill.category}]</span>
            </div>

            <p class="term-card-description">{skill.description}</p>

            <div class="term-card-footer">
              <span class="term-card-tags">
                {skill.subdirs.slice(0, 2).map(tag => `#${tag}`).join(" ")}
              </span>
              <span class="term-card-meta">
                {skill.fileCount}f · {(skill.zipSize / 1024).toFixed(1)}KB · <span class="term-downloads">↓ {Math.floor(Math.random() * 500)}</span>
              </span>
            </div>
          </article>
        ))}
      </div>

      <div class="term-footer-info">
        <span id="visible-count">{skills.length} results</span> · press <span class="term-accent">/</span> to search · <span class="term-accent">↵</span> to open
      </div>
    </section>

  </main>
</Layout>

<script>
  function setupTerminal() {
    const searchInput = document.getElementById("skill-search") as HTMLInputElement;
    const grid = document.getElementById("skills-grid")!;
    const cards = grid.querySelectorAll<HTMLElement>(".term-skill-card");
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".term-filter-btn");
    const visibleCount = document.getElementById("visible-count")!;
    const themeBtn = document.getElementById("term-theme-toggle");
    const total = cards.length;

    let activeCategory = "all";

    function applyFilters() {
      const query = searchInput.value.toLowerCase().trim();
      let visible = 0;

      cards.forEach((card) => {
        const name = card.querySelector(".term-card-name")?.textContent?.toLowerCase() || "";
        const desc = card.querySelector(".term-card-description")?.textContent?.toLowerCase() || "";
        const category = card.getAttribute("data-category") || "";

        const matchesSearch = !query || name.includes(query) || desc.includes(query);
        const matchesCategory = activeCategory === "all" || category === activeCategory;
        const show = matchesSearch && matchesCategory;

        card.style.display = show ? "" : "none";
        if (show) visible++;
      });

      visibleCount.textContent = `${visible} results`;
    }

    searchInput.addEventListener("input", applyFilters);
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        searchInput.value = "";
        searchInput.blur();
        applyFilters();
      }
    });

    // Filter button clicks
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeCategory = btn.getAttribute("data-filter") || "all";
        applyFilters();
      });
    });

    // "/" key to focus search
    document.addEventListener("keydown", (e) => {
      if (e.key === "/" && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
      }
    });

    // Theme toggle
    if (themeBtn) {
      themeBtn.addEventListener("click", () => {
        const element = document.documentElement;
        const currentTheme = element.getAttribute("data-theme") || "dark";
        const targetTheme = currentTheme === "light" ? "dark" : "light";

        element.setAttribute("data-theme", targetTheme);
        localStorage.setItem("theme", targetTheme);
        themeBtn.textContent = `[${targetTheme}]`;
      });

      // Set initial text
      const currentTheme = document.documentElement.getAttribute("data-theme") || "dark";
      themeBtn.textContent = `[${currentTheme}]`;
    }
  }

  setupTerminal();
  document.addEventListener("astro:after-swap", setupTerminal);
</script>

<style>
  .terminal-main {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    font-family: "JetBrains Mono", monospace;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--term-bg);
    color: var(--term-text);
    overflow-x: hidden;
  }

  /* Scanlines effect */
  .terminal-main::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 100;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 2px,
      var(--term-scanline) 2px 3px
    );
  }

  /* Status Bar */
  .term-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 16px;
    border-bottom: 1px solid var(--term-border);
    background: var(--term-surf);
    font-size: 11px;
    color: var(--term-text-secondary);
    gap: 14px;
    flex-shrink: 0;
  }

  .status-left,
  .status-right {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .status-online {
    color: var(--term-accent);
  }

  .status-theme {
    background: none;
    border: none;
    color: var(--term-text-secondary);
    cursor: pointer;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    padding: 0;
    transition: color 150ms;
  }

  .status-theme:hover {
    color: var(--term-accent);
  }

  /* Hero Section */
  .term-hero {
    padding: 28px 32px 20px;
    border-bottom: 1px solid var(--term-border);
  }

  .term-ascii-art {
    margin: 0;
    font-family: "JetBrains Mono", monospace;
    color: var(--term-accent);
    font-size: 11px;
    line-height: 1.1;
    letter-spacing: 0;
    text-shadow: 0 0 8px var(--term-accent-glow);
  }

  .term-hero-content {
    margin-top: 16px;
    display: flex;
    gap: 40px;
    align-items: flex-end;
  }

  .term-desc {
    flex: 1;
  }

  .term-prompt {
    color: var(--term-text-tertiary);
    font-size: 12px;
    margin-bottom: 6px;
  }

  .term-tagline {
    margin: 0;
    font-size: 14px;
    color: var(--term-text);
    max-width: 580px;
    line-height: 1.55;
    font-family: system-ui, sans-serif;
  }

  .term-symbol {
    color: var(--term-accent);
    font-family: "JetBrains Mono", monospace;
  }

  .term-stats {
    display: flex;
    gap: 24px;
    font-size: 11px;
    color: var(--term-text-secondary);
  }

  .term-stat {
    display: flex;
    flex-direction: column;
  }

  .term-stat-label {
    color: var(--term-text-tertiary);
    font-size: 10px;
    margin-bottom: 2px;
  }

  .term-stat-value {
    font-size: 22px;
    color: var(--term-accent);
    font-weight: 600;
    font-family: "JetBrains Mono", monospace;
  }

  .term-stat-value.downloads {
    color: var(--term-warn);
  }

  /* Search & Filters */
  .term-search-section {
    padding: 12px 16px;
    border-bottom: 1px solid var(--term-border);
    background: var(--term-surf);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .term-prompt-line {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    max-width: 380px;
  }

  .term-symbol {
    color: var(--term-accent);
  }

  .term-grep-cmd {
    color: var(--term-text-secondary);
  }

  #skill-search {
    background: none;
    border: none;
    color: var(--term-text);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    flex: 1;
    border-bottom: 1px solid var(--term-text-tertiary);
    padding-bottom: 1px;
    outline: none;
  }

  #skill-search::placeholder {
    color: var(--term-text);
  }

  .term-search-path {
    color: var(--term-text-tertiary);
    font-size: 12px;
  }

  .term-filters {
    display: flex;
    gap: 4px;
  }

  .term-filter-btn {
    padding: 4px 10px;
    border-radius: 0;
    background: transparent;
    color: var(--term-text-secondary);
    border: 1px solid var(--term-border);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    cursor: pointer;
    transition: all 150ms;
  }

  .term-filter-btn:hover {
    border-color: var(--term-accent);
    color: var(--term-accent);
  }

  .term-filter-btn.active {
    background: var(--term-text);
    color: var(--term-bg);
    border-color: var(--term-text);
  }

  .term-filter-count {
    opacity: 0.5;
    margin-left: 4px;
  }

  /* Grid Section */
  .term-grid-section {
    flex: 1;
    overflow: auto;
    padding: 16px 16px 24px;
    display: flex;
    flex-direction: column;
  }

  .term-grid-border {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border: 1px solid var(--term-border);
  }

  .term-skill-card {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-right: 1px solid var(--term-border);
    border-bottom: 1px solid var(--term-border);
  }

  .term-skill-card:nth-child(odd) {
    border-right: 1px solid var(--term-border);
  }

  .term-skill-card:nth-child(even) {
    border-right: none;
  }

  .term-skill-card:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .term-card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .term-card-title-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }

  .term-card-number {
    color: var(--term-text-tertiary);
    font-size: 11px;
  }

  .term-card-name {
    color: var(--term-text);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term-card-category {
    color: var(--term-text-tertiary);
    font-size: 10px;
    white-space: nowrap;
  }

  .term-card-description {
    margin: 0;
    color: var(--term-text-secondary);
    font-size: 12px;
    line-height: 1.5;
    font-family: system-ui, sans-serif;
  }

  .term-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10px;
    color: var(--term-text-tertiary);
    margin-top: 2px;
  }

  .term-card-tags {
    font-family: "JetBrains Mono", monospace;
  }

  .term-downloads {
    color: var(--term-accent);
  }

  .term-footer-info {
    margin-top: 12px;
    font-size: 11px;
    color: var(--term-text-tertiary);
  }

  .term-accent {
    color: var(--term-accent);
  }

  /* Theme Variables */
  :root {
    --term-bg: #0c0c0c;
    --term-surf: #141414;
    --term-border: #2a2a2a;
    --term-text: #e7e7e7;
    --term-text-secondary: #8a8a8a;
    --term-text-tertiary: #555;
    --term-accent: #39ff14;
    --term-accent-glow: rgba(57, 255, 20, 0.4);
    --term-warn: #ffb454;
    --term-scanline: rgba(255, 255, 255, 0.012);
  }

  html[data-theme="light"] {
    --term-bg: #f4f3ee;
    --term-surf: #ebe9e1;
    --term-border: #1a1a1a;
    --term-text: #0a0a0a;
    --term-text-secondary: #3a3a3a;
    --term-text-tertiary: #7a7a7a;
    --term-accent: #1a7f37;
    --term-accent-glow: rgba(26, 127, 55, 0.2);
    --term-warn: #a8550c;
    --term-scanline: rgba(0, 0, 0, 0.02);
  }

  @media (max-width: 768px) {
    .term-hero-content {
      flex-direction: column;
      gap: 20px;
      align-items: flex-start;
    }

    .term-stats {
      width: 100%;
      gap: 16px;
    }

    .term-search-section {
      flex-direction: column;
    }

    .term-prompt-line {
      max-width: 100%;
    }

    .term-grid-border {
      grid-template-columns: 1fr;
    }

    .term-skill-card {
      border-right: none;
      border-bottom: 1px solid var(--term-border);
    }
  }
</style>
